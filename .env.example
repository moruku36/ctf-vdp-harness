# Example environment configuration for ctf-vdp-harness (placeholders only; never commit real secrets).
# See docs/05-security(.ja).md section 9 and docs/10-implementation-plan(.ja).md.

CTF_MCP_PROFILE=offline_ctf
CTF_MCP_TRANSPORT=stdio

# Private local directories outside Git working tree
CTF_MCP_VAULT_ROOT=CHANGE_ME_PRIVATE_VAULT_ROOT
CTF_MCP_DB_PATH=CHANGE_ME_PRIVATE_SQLITE_DB_PATH
CTF_MCP_WORKSPACE_ROOT=CHANGE_ME_WORKSPACE_ROOT

# Secret material (replace locally outside Git; minimum 32 hex chars / 16 bytes for HMAC)
CTF_MCP_CURSOR_HMAC_KEY=CHANGE_ME_CURSOR_HMAC_SECRET_HEX
CTF_MCP_AUTH_TOKEN=CHANGE_ME_HTTP_BEARER_TOKEN_IF_HTTP_ENABLED

# Optional runtime settings
CTF_MCP_LOG_LEVEL=INFO

# Required on Windows Python 3.15 without MSVC Build Tools when installing fastmcp/PyYAML
PYYAML_FORCE_LIBYAML=0
